# Protege's API key. Read from environment first, then from ~/.protege/.env
# To use: Copy this example there, add your key, make it readable only by you:
#
#   mkdir -p ~/.protege
#   cp .env.example ~/.protege/.env
#   chmod 600 ~/.protege/.env
#
# The name must match provider.apiKeyEnv in protege.yaml (OPENAI_API_KEY by default)
PROTEGE_API_KEY=